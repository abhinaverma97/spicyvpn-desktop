{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpicyVPN",
  "version": "1.0.71",
  "identifier": "app.spicypepper.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SpicyVPN",
        "width": 380,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "wintun.dll"
    ],
    "externalBin": [
      "sing-box"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
